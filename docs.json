{
  "$schema": "https://mintlify.com/docs.json",
  "name": "TLDP API Documentation",
  "theme": "mint",
  "colors": {
    "primary": "#3b82f6",
    "light": "#60a5fa",
    "dark": "#3b82f6"
  },
  "favicon": "/branding/tldp-icon.png",
  "seo": {
    "metatags": {
      "og:site_name": "TLDP Documentation",
      "og:title": "TLDP — one API for logistics",
      "og:description": "Quote, ship, track and return across many couriers through a single API.",
      "og:image": "/branding/og-image.png",
      "og:image:width": "1200",
      "og:image:height": "630",
      "og:type": "website",
      "og:locale": "en_GB",
      "twitter:card": "summary_large_image",
      "twitter:title": "TLDP — one API for logistics",
      "twitter:description": "Quote, ship, track and return across many couriers through a single API.",
      "twitter:image": "/branding/og-image.png"
    },
    "indexing": "all"
  },
  "logo": {
    "light": "/branding/tldp-long-blue.svg",
    "dark": "/branding/tldp-long-white.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "How TLDP Works",
            "pages": [
              "how-tldp-works/overview",
              "how-tldp-works/pricing",
              "how-tldp-works/geography",
              "how-tldp-works/request-lifecycle",
              "how-tldp-works/dispatch",
              "how-tldp-works/caching",
              "how-tldp-works/returns"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "webhooks"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.yaml",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "api-reference/introduction"
            ]
          }
        ]
      },
      {
        "tab": "TypeScript SDK",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "sdk/introduction"
            ]
          },
          {
            "group": "Orders & Fulfilment",
            "pages": [
              "sdk/api-reference/classes/OrdersService",
              "sdk/api-reference/classes/ShipmentsService",
              "sdk/api-reference/classes/RatesService"
            ]
          },
          {
            "group": "Tracking & Delivery",
            "pages": [
              "sdk/api-reference/classes/TrackingService",
              "sdk/api-reference/classes/ProofOfDeliveryService"
            ]
          },
          {
            "group": "Reverse Logistics",
            "pages": [
              "sdk/api-reference/classes/ReturnsService"
            ]
          },
          {
            "group": "Integrations & System",
            "pages": [
              "sdk/api-reference/classes/WebhooksService",
              "sdk/api-reference/classes/SystemService"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://tldp.tybritelabs.com",
          "icon": "gauge"
        },
        {
          "anchor": "npm",
          "href": "https://www.npmjs.com/package/@tybrite-labs/tldp-sdk",
          "icon": "npm"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@tybritelabs.com",
          "icon": "envelope"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://tldp.tybritelabs.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "/quickstart"
    }
  },
  "footer": {
    "socials": {
      "website": "https://tldp.tybritelabs.com",
      "github": "https://github.com/tybrite"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  }
}
